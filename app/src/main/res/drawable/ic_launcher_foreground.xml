<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ============================================================ -->
    <!--  TYPEWRITER KEY — outer ring (circular key cap)              -->
    <!-- ============================================================ -->

    <!-- Key cap outer ring — chrome/nickel finish -->
    <path
        android:pathData="M54,54m-24,0a24,24,0,1,1,48,0a24,24,0,1,1,-48,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="50"
                android:centerY="50"
                android:gradientRadius="26">
                <item android:color="#FFDBD4C8" android:offset="0.0" />
                <item android:color="#FFC2B9AA" android:offset="0.5" />
                <item android:color="#FF9E9486" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Key cap inner well — darker inset -->
    <path
        android:pathData="M54,54m-20.5,0a20.5,20.5,0,1,1,41,0a20.5,20.5,0,1,1,-41,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="52"
                android:centerY="52"
                android:gradientRadius="22">
                <item android:color="#FF2E2A25" android:offset="0.0" />
                <item android:color="#FF1E1B17" android:offset="0.7" />
                <item android:color="#FF151210" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Key cap highlight ring — metallic sheen on top edge -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54m-22.2,0a22.2,22.2,0,1,1,44.4,0a22.2,22.2,0,1,1,-44.4,0"
        android:strokeWidth="0.6"
        android:strokeColor="#33FFFFFF" />

    <!-- Outer ring bottom shadow arc for depth -->
    <path
        android:fillColor="#00000000"
        android:pathData="M35.5,66 A22,22,0,0,0,72.5,66"
        android:strokeWidth="0.5"
        android:strokeColor="#22000000" />

    <!-- ============================================================ -->
    <!--  LETTER "T" — elegant serif typeface character               -->
    <!-- ============================================================ -->

    <!-- The T glyph — warm cream/ivory on dark key -->
    <path
        android:pathData="
            M41.2,43.5
            L41.2,41.6
            L66.8,41.6
            L66.8,43.5
            L55.5,43.5
            L55.5,66.4
            L52.5,66.4
            L52.5,43.5
            Z

            M41.2,41.6
            L41.2,40.6
            Q41.2,39.6,42.2,39.6
            L65.8,39.6
            Q66.8,39.6,66.8,40.6
            L66.8,41.6

            M41.2,43.5
            L43.8,43.5
            L43.8,44.5
            Q43.8,45.5,42.8,45.5
            L41.2,45.5
            Q40.2,45.5,40.2,44.5
            L40.2,43.5

            M66.8,43.5
            L64.2,43.5
            L64.2,44.5
            Q64.2,45.5,65.2,45.5
            L67.8,45.5
            Q67.8,44.5,67.8,43.5

            M52.5,66.4
            L52.5,67.4
            Q52.5,68.4,51.5,68.4
            L49.5,68.4
            Q48.5,68.4,48.5,67.4
            L48.5,66.4
            L52.5,66.4

            M55.5,66.4
            L55.5,67.4
            Q55.5,68.4,56.5,68.4
            L58.5,68.4
            Q59.5,68.4,59.5,67.4
            L59.5,66.4
            L55.5,66.4
        ">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="39"
                android:endX="54"
                android:endY="69">
                <item android:color="#FFF5EBD6" android:offset="0.0" />
                <item android:color="#FFE6D5B8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ============================================================ -->
    <!--  SUBTLE KEY STEM (vertical post beneath the key)             -->
    <!-- ============================================================ -->
    <path
        android:pathData="M51.5,78 L56.5,78 L56.5,83 Q54,85,51.5,83 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="78"
                android:endX="54"
                android:endY="85">
                <item android:color="#FF9E9486" android:offset="0.0" />
                <item android:color="#44605550" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Thin vertical arm connecting key to stem -->
    <path
        android:pathData="M52.8,78 L55.2,78 L55.2,74 Q54,73.5,52.8,74 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="73.5"
                android:endX="54"
                android:endY="78">
                <item android:color="#AADBD4C8" android:offset="0.0" />
                <item android:color="#FF9E9486" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ============================================================ -->
    <!--  ACCENT — tiny red ribbon dot at the base of the T crossbar  -->
    <!-- ============================================================ -->
    <path
        android:pathData="M54,54m-1.6,0a1.6,1.6,0,1,1,3.2,0a1.6,1.6,0,1,1,-3.2,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="2">
                <item android:color="#FFD93B33" android:offset="0.0" />
                <item android:color="#FF9E2A22" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ============================================================ -->
    <!--  HIGHLIGHTS AND POLISH                                       -->
    <!-- ============================================================ -->

    <!-- Specular highlight on the top of the key ring -->
    <path
        android:pathData="M40,44 Q47,31,68,44"
        android:fillColor="#00000000"
        android:strokeWidth="0.8"
        android:strokeColor="#22FFFFFF" />

    <!-- Very faint cast shadow below the entire key -->
    <path
        android:pathData="M38,79 Q54,84,70,79"
        android:fillColor="#00000000"
        android:strokeWidth="3"
        android:strokeColor="#11000000" />

</vector>